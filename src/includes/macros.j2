{% import 'includes/site.j2' as site %}
{% macro cite( vargs ) -%}
  {%- for p in vargs -%}
  <a href='{{p.jlink}}'>
    {{- p.sjournal ~ ' ' ~ ( p.year % 1000 ) -}}
    {%- if not loop.last -%}, {% endif -%}
  </a>
  {%- endfor -%}
{%- endmacro -%}

{%- macro tpubs( all, tag ) %}
  {%- set flist = [] -%}
  {%- for p in all -%}
    {%- if tag in p.tags -%}
      {%- set _ = flist.append(p) %}
    {%- endif -%}
  {%- endfor -%}
  {{- pubs( flist ) -}}
{%- endmacro -%}

{% macro pubs( list ) %}
  {% for p in list %}
    <li>
      {% if p.link or p.code %}
	<div class='btn-group text-nowrap tight-float-right'>
	  {%- if p.link -%}
	    <a class='btn btn-default btn-xs' href='{{site.url}}/research/papers/{{p.link}}' title='Download preprint'>
	      <span class='glyphicon glyphicon-download'></span>
	    </a>
	  {% endif %}
	  {% if p.twoup %}
	    <a class='btn btn-default btn-xs' href='{{site.url}}/research/papers/{{p.twoup}}' title='Download 2up preprint for eco-friendly printing'>
	      <span class='glyphicon glyphicon-print'></span>
	    </a>
	  {% endif %}
	  {#
	  {% if p.jlink %}
	    <a class='btn btn-default btn-xs' href='{{p.jlink}}' title='Official journal link'>
	      <span class='glyphicon glyphicon-book'></span>
	    </a>
	  {% endif %}
	  #}
	  {% if p.code or p.fcode %}
	    <a class='btn btn-default btn-xs'
	      href='{{(site.url ~ '/research/' ~ p.code) if p.code
		else p.fcode }}'
	      title='Code and Figures'>
	      <span class='glyphicon glyphicon-sunglasses'></span>
	    </a>
	  {%- endif -%}
	</div>
      {% endif %}
      {% for a in p.authors %}
	<span class='text-nowrap'>{{a}},</span>
      {% endfor %}
      <i>{{p.title ~ (',' if p.journal else '.')}}</i>
      {% if p.jlink %}<a href='{{p.jlink}}' title='Published paper from journal website'>{% endif %}
	{{p.journal ~ ( ' ('~p.year~').' if p.year else '.' ) }}
      {% if p.jlink %}</a>{% endif %}
    </li>
  {% endfor %}
{% endmacro %}
