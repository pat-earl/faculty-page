{%- import 'includes/site.j2' as site -%}
{%- from 'layouts/frag/nav.j2' import nav_bar -%}
{%- from 'layouts/frag/footer.j2' import footer with context -%}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#-
      The above 3 meta tags *must* come first in the head; any other head
      content must come *after* these tags
    #}
    <meta name="author" content="{{ site_author }}">
    <title>
      {{ ( title or site_title ) | striptags | default( 'No Title' )}}
    </title>

    {%- block stylesheets -%}
      {%- if dev_env == 'production' -%}
	{%- set min = '.min' -%}
	{%- set bootstrap_cdn = 'https://maxcdn.bootstrapcdn.com/bootstrap' -%}
      {%- else -%}
	{%- set min = '' -%}
	{%- set bootstrap_cdn = get_link('/dev/static/bootstrap', true) -%}
      {%- endif -%}
      <link rel="stylesheet"
	href="{{bootstrap_cdn}}/3.3.7/css/bootstrap{{min}}.css">
      <link rel="stylesheet"
	href="{{site_prefix}}/share/css/pygments-theme.css">
      <link rel="stylesheet" href="{{site_prefix}}/share/css/local.css">
    {%- endblock -%}

    {#-
      HTML5 shim and Respond.js for IE8 support of HTML5 elements and media
      queries. WARNING: Respond.js doesn't work if you view the page via
      file://
    -#}
    {%- set min = '.min' if dev_env == 'production' else '' -%}
    <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv{{min}}.js">
      </script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond{{min}}.js">
      </script>
    <![endif]-->
  </head>
  <body {% block bodyargs -%}{%- endblock -%}>
    {%- block nav %}{{ nav_bar(active|default(dirname, true) ) }}{% endblock -%}

    {% block pre_container %}{% endblock -%}
    <div class='container'>
      {% block body -%}
	<h1>{{title | default("No Title.") }}</h1>
	<p class='lead'>Default body block goes here.</p>
	{{ lipsum() }}
      {%- endblock -%}
    </div>

    {% block footer scoped -%}{{ footer(page_email) }}{%- endblock -%}

    {#- Hopefully this will inherit the needs_mathjax variable -#}
    {%- block scripts scoped -%}
      {#- jQuery (necessary for Bootstrap's JavaScript plugins) -#}
      {%- if dev_env == 'production' -%}
	{%- set min = '.min' -%}
	{%- set jquery_cdn = 'https://ajax.googleapis.com/ajax/libs/jquery' -%}
	{%- set bootstrap_cdn = 'https://maxcdn.bootstrapcdn.com/bootstrap' -%}
      {%- else -%}
	{%- set min = '' -%}
	{%- set jquery_cdn = get_link('/dev/static/jquery', true) -%}
	{%- set bootstrap_cdn = get_link('/dev/static/bootstrap', true) -%}
      {%- endif -%}

      <script src="{{jquery_cdn}}/1.12.4/jquery{{min}}.js">
      </script>
      {#-
	Include all compiled plugins (below), or include individual files as
	needed
      #}
      <script src="{{bootstrap_cdn}}/3.3.7/js/bootstrap{{min}}.js">
      </script>

      {%- if needs_mathjax -%}
	<script src='{{get_link('/share/js/mathjax-config.js', true)}}'></script>
	<script src="https://cdn.mathjax.org/mathjax/latest/MathJax.js?config=TeX-AMS_HTML"></script>
      {%- endif -%}

      {%- if dev_env != 'production' and live_reload -%}
	<script src='{{get_link('/dev/static/livejs/live.js', true)}}></script>
      {%- endif -%}

      <script src='{{get_link('/share/js/local.js', true)}}'></script>
    {%- endblock scripts -%}
  </body>
</html>
