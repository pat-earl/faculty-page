{% set active = 'teaching' %}
{%- macro md_hw() -%}
  {%- include get_file(hw | default( '_hw.md', true )) ignore missing -%}
{%- endmacro -%}
{%- macro md_handouts() -%}
  {%- include get_file(handouts | default( '_handouts.md', true )) ignore missing -%}
{%- endmacro -%}
{% extends "layouts/md-nav-right-affix.j2" %}
{% block nav_after_toc %}
  {% if md_hw() or md_handouts() %}
    <div id='hw-handouts' class='row small'>
      {% if md_hw() %}
	<div class='col-md-12 col-sm-6'>
	  <h4 class='hidden-xs hidden-sm'>Homework and Solutions</h4>
	  <h2 class='hidden-md hidden-lg'>Homework and Solutions</h2>
	  {{ md_hw() | markdown }}
	</div>
      {% endif %}
      {% if md_handouts() %}
	<div class='col-md-12 col-sm-6'>
	  <h4 class='hidden-xs hidden-sm'>Handouts</h4>
	  <h2 class='hidden-md hidden-lg'>Handouts</h2>
	  {{ md_handouts() | markdown }}
	</div>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
