{% set active = 'teaching' %}
{% import 'includes/macros.j2' as macros %}
{% extends "layouts/nav-left.j2" %}
{% block nav_column %}
  {{ super() }}
  {% if hw or handouts %}
    <div class='row'>
      {% if hw %}
	<div class='col-md-12 col-sm-6'>
	  <h4 class='hidden-xs hidden-sm'>Homework and Solutions</h4>
	  <h2 class='hidden-md hidden-lg'>Homework and Solutions</h2>
	  {{ markdown( hw ) }}
	</div>
      {% endif %}
      {% if handouts %}
	<div class='col-md-12 col-sm-6'>
	  <h4 class='hidden-xs hidden-sm'>Handouts</h4>
	  <h2 class='hidden-md hidden-lg'>Handouts</h2>
	  {{ markdown( handouts ) }}
	</div>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
{% block main_column %}
  {# <h2 id='logistical-information'>Logistical Information</h2> #}
  <table class='table' summary='Logistical Information'>
    <tbody>{# Instructor, lectures {{{ #}
      <tr>
	<th scope='row'>Instructor</th>
	<td>
	  <a href='{{author_url}}'>{{site_author}}</a>.
	  &emsp;
	  {{ macros.room( author_office_bldg, author_office_room ) }}
	  &emsp;
	  {{ macros.email(author_email) }}
	</td>
      </tr>
      {% if lectures %}
      <tr>
	<th scope='row'>Lectures</th>
	<td>
	  {% if lectures is string %}
	    {{lectures}}
	  {% else %}
	    {{lectures[0]}} in
	    {{macros.room( lectures[1], lectures[2], is_office=false ) }}
	  {% endif %}
	</td>
      </tr>
      {% endif %}
      {% if office_hours %}
      <tr>
	<th scope='row'>
	  Office Hours
	  {% if ta_office_hours %}(instructor){% endif %}
	</th>
	<td>
	  {{office_hours}}
	</td>
      </tr>
      {% endif %}
    </tbody>{# }}} #}
    {% if ta %}{# TA {{{ #}
      <tbody>
	<tr>
	  <th scope='row'>TA</th>
	  <td>
	    {% if ta_website %}
	      <a href='{{ta_website}}'>{{ta}}</a>.
	    {% else %}
	      {{ta}}.
	    {% endif %}
	    {% if ta_office %}
	      &emsp;
	      {{ macros.room( ta_office[0], ta_office[1] ) }}
	    {% endif %}
	    {% if ta_email %}
	      &emsp;
	      {{ macros.email( ta_email ) }}
	    {% endif %}
	  </td>
	</tr>
	{% if recitation %}
	  <tr>
	    <th scope='row'>Recitation</th>
	    <td>
	      {% if recitation is string %}
		{{recitation}}
	      {% else %}
		{{recitation[0]}} in
		{{macros.room( recitation[1], recitation[2], is_office=false ) }}
	      {% endif %}
	    </td>
	  </tr>
	{% endif %}
	{% if ta_office_hours %}
	  <tr>
	    <th scope='row'>Office Hours (TA)</th>
	    <td>{{ta_office_hours}}</td>
	  </tr>
	{% endif %}
      </tbody>
    {% endif %}{# }}} TA #}
    {% if dates %}{# {{{ #}
    <tbody>
      {% for s in dates %}
	{% if loop.index is odd %}
	  <tr>
	    <th scope='row'>{{s}}</th>
	{% else %}
	    <td>{{s}}</td>
	  </tr>
	{% endif %}
      {% endfor %}
    </tbody>
    {% endif %}{# }}} #}
    {% if mailing_list %}{# Mailing list {{{ #}
      <tbody>
	<tr>
	  <th scope='row'>Mailing list</td>
	  <td>
	    <a href='{{mailing_list[0]}}'>{{mailing_list[1]}}</a>
	    <span class='small'>
	      (Students and guests
	      <span class='bg-warning'>
		<b>please subscribe to this list</b>.
	      </span>
	      I will NOT use BlackBoard.)
	    </span>
	  </td>
	</tr>
      </tbody>
    {% endif %}{# }}} #}
  </table>

  <div>{# Use class='lead' to get a bigger font! #}
    {{ content }}
  </div>
{% endblock %}
