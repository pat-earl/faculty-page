{%- from 'includes/macros.j2' import post_date -%}
{%- macro md_sidenav() -%}
  {%- include dirname ~ '/' ~ (sidenav | default( '_sidenav.md', true )) ignore missing -%}
{%- endmacro -%}
{% extends md_nav_layout | default("layouts/nav-right.j2") -%}
{% block main_column -%}
  <div class='justify{{" lead" if bigfont}}'>
    {% block title_block -%}
      {% if title -%}<h1>{{title}}</h1>{% endif -%}
      {% if subtitle or post_date(basename) -%}
	<p class='text-secondary mt-0 mb-3'>
	  {{subtitle | default(post_date(basename))}}
	</p>
      {% endif -%}
    {% endblock -%}

    {% block content_block -%}
      {{ content }}
    {% endblock -%}

    {% block comments_block -%}
    {% endblock -%}
  </div>
{% endblock -%}
{% block nav_after_toc -%}
  {% if md_sidenav() -%}
    {{ md_sidenav() | markdown }}
  {% endif -%}
{% endblock -%}
