{%- extends "layouts/nav-right.j2" -%}
{%- block bodyargs -%}
  style='position: relative' data-spy='scroll' data-target='#col-right'
{%- endblock -%}
{% block nav_column %}
  <div id='before-affix'></div>{# Empty div, right before the affix. #}
  <div data-affix-after='#before-affix'>
    {% block nav_affix_before_toc %}{% endblock %}
    {{ super() }}
    {% block nav_affix_after_toc %}{% endblock %}
  </div>{# affix #}
{% endblock %}
