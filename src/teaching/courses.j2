{% set courses = (
    (101, 'Computer Applications', (

    )),

    (111, 'Computer Forensics', (
        (2021, 's', '2020-2021/111-comp-foren'),
    )),
    
    (120, 'Introduction to Creative Graphical Coding', (
        (2021, 's', '2020-2021/120-graph-coding'),
    )),

    (123, 'Introduction Secientfic Programming', (
        (2020, 's', old_teaching ~ 'SP2020/CSC223'),
    )),

    (135, 'Computer Science I', (
        (2020, 'f', old_teaching ~ 'FA2020/CSC135/'),
    )),

    (223, 'Advanced Scientific Programming', (
        (2021, 's', '2020-2021/223-adv-sci-program'),
    )),

    (252, 'UNIX: Scripting & Administration', (
        (2021, 's', '2020-2021/252-unix-admin'),
        (2020, 's', old_teaching ~ 'SP2020/CSC252/'),
