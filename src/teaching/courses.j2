        (2020, 'f', old_teaching ~ 'FA2020/CSC311/'),
    )),

  ) %}
{# {% set cur_index = () %} #}
{# Use this to set the current courses! #}
{# Don't try to index stuff either :> #}
{% set cur_index = ( (1, 0), (2, 0), (5, 0), (6, 0), ) %}
{% macro md_current_courses() -%}
{% for i, j in cur_index -%}
{%- set c = courses[i] %}
{%- set (cn, ct, cl) = (c[0], c[1], 'teaching/' ~ c[2][j][2]) %}
* [{{ ('CSC' ~cn~': ' if cn else '' ) ~ ct}}]({{cl}})
{%- endfor %}
{% endmacro %}

{% macro md_current_courses_long() -%}
{% for i, j in cur_index -%}
    {% set (cn, ct) = (courses[i][0], courses[i][1]) -%}
    {% set (cy, cs, cl) = courses[i][2][j] -%}
    {% if cs == 's' -%}
        {% set cs = 'Spring, ' -%}
    {% elif cs == 'f' -%}
        {% set cs = 'Fall, ' -%}
    {% else -%}
        {% set cs = '' -%}
    {% endif -%}
* [{{- ('CSC' ~cn~': ' if cn else '') ~ ct}} ({{cs ~ cy}})]({{cl -}})
{% else -%}
I'm not teaching this semester.
{%- endfor %}
{% endmacro %}
